{
  "datasets": [
    {
      "displayName": "Boletín de la última emisión",
      "name": "ds_boletin",
      "queryLines": [
        "WITH ultima AS (\n",
        "  SELECT max(emision) AS emision FROM vigia.gold.alertas\n",
        "),\n",
        "boletin AS (\n",
        "  SELECT a.*, CASE a.nivel WHEN 'roja' THEN 'Roja' WHEN 'amarilla' THEN 'Amarilla' WHEN 'verde' THEN 'Verde' ELSE 'Sin canal' END AS alerta,\n",
        "         CASE a.nivel WHEN 'roja' THEN 1 WHEN 'amarilla' THEN 2 WHEN 'verde' THEN 3 ELSE 4 END AS orden\n",
        "  FROM vigia.gold.alertas a\n",
        "  JOIN ultima u ON a.emision = u.emision\n",
        ")\n",
        "SELECT b.provincia, b.dpa_provin, b.emision, b.anio_epi, b.semana_epi, b.fecha_emision, b.alerta, b.orden,\n",
        "       concat('<span style=\"background-color:',\n",
        "              CASE b.alerta WHEN 'Roja' THEN '#d03b3b' WHEN 'Amarilla' THEN '#fab219'\n",
        "                            WHEN 'Verde' THEN '#0ca30c' ELSE '#8a8a85' END,\n",
        "              ';color:', CASE b.alerta WHEN 'Amarilla' THEN '#0b0b0b' ELSE '#ffffff' END,\n",
        "              ';padding:2px 10px;border-radius:10px;font-weight:600\">', b.alerta, '</span>') AS etiqueta,\n",
        "       b.motivo, b.casos_semana, b.casos_4s, b.camas_dia_4s, b.camas_promedio,\n",
        "       g.latitud, g.longitud\n",
        "FROM boletin b\n",
        "LEFT JOIN vigia.gold.dim_geografia g ON g.dpa_canton = concat(b.dpa_provin, '01')\n",
        "ORDER BY b.orden, b.casos_4s DESC\n"
      ]
    },
    {
      "displayName": "Resumen de la última emisión",
      "name": "ds_resumen",
      "queryLines": [
        "WITH ultima AS (\n",
        "  SELECT max(emision) AS emision FROM vigia.gold.alertas\n",
        ")\n",
        "SELECT max(a.anio_epi) AS anio_epi, max(a.semana_epi) AS semana_epi, max(a.fecha_emision) AS fecha_emision,\n",
        "       count_if(a.nivel = 'roja') AS rojas, count_if(a.nivel = 'amarilla') AS amarillas,\n",
        "       round(sum(a.casos_4s)) AS casos_4s, round(sum(a.camas_promedio), 1) AS camas_promedio\n",
        "FROM vigia.gold.alertas a\n",
        "JOIN ultima u ON a.emision = u.emision\n"
      ]
    },
    {
      "displayName": "Casos, pronóstico y canal por provincia",
      "name": "ds_serie",
      "queryLines": [
        "WITH ultima AS (\n",
        "  SELECT max(emision) AS emision FROM vigia.gold.pronosticos\n",
        "),\n",
        "pasado AS (\n",
        "  SELECT d.provincia, d.inicio_semana AS semana, d.casos,\n",
        "         CASE WHEN d.inicio_semana = u.emision THEN d.casos END AS pronostico,\n",
        "         CASE WHEN d.inicio_semana = u.emision THEN d.casos END AS pronostico_bajo,\n",
        "         CASE WHEN d.inicio_semana = u.emision THEN d.casos END AS pronostico_alto,\n",
        "         CASE WHEN c.q3 IS NOT NULL THEN greatest(c.q3, 5) END AS umbral_epidemico,\n",
        "         CASE WHEN c.mediana IS NOT NULL THEN greatest(c.mediana, 5) END AS umbral_alerta\n",
        "  FROM vigia.gold.dengue_semana d\n",
        "  CROSS JOIN ultima u\n",
        "  LEFT JOIN vigia.gold.canal_endemico c\n",
        "    ON c.dpa_provin = d.dpa_provin AND c.anio_epi = d.anio_epi AND c.semana_epi = d.semana_epi\n",
        "  WHERE d.inicio_semana > date_sub(u.emision, 182) AND d.inicio_semana <= u.emision\n",
        "),\n",
        "futuro AS (\n",
        "  SELECT p.provincia, p.objetivo AS semana, CAST(NULL AS DOUBLE) AS casos,\n",
        "         p.pronostico, p.pronostico_bajo, p.pronostico_alto,\n",
        "         CASE WHEN p.canal_q3 IS NOT NULL THEN greatest(p.canal_q3, 5) END AS umbral_epidemico,\n",
        "         CASE WHEN p.canal_mediana IS NOT NULL THEN greatest(p.canal_mediana, 5) END AS umbral_alerta\n",
        "  FROM vigia.gold.pronosticos p\n",
        "  JOIN ultima u ON p.emision = u.emision\n",
        "),\n",
        "ancho AS (\n",
        "  SELECT * FROM pasado\n",
        "  UNION ALL\n",
        "  SELECT * FROM futuro\n",
        ")\n",
        "SELECT a.provincia, a.semana, s.serie, round(s.valor, 1) AS casos\n",
        "FROM ancho a\n",
        "LATERAL VIEW stack(6, 'Casos', a.casos, 'Pronóstico', a.pronostico,\n",
        "                   'Límite bajo (80 %)', a.pronostico_bajo, 'Límite alto (80 %)', a.pronostico_alto,\n",
        "                   'Umbral epidémico', a.umbral_epidemico, 'Umbral de alerta', a.umbral_alerta) s AS serie, valor\n",
        "WHERE s.valor IS NOT NULL\n"
      ]
    },
    {
      "displayName": "Niveles de las últimas 12 emisiones",
      "name": "ds_historial",
      "queryLines": [
        "WITH emisiones AS (\n",
        "  SELECT DISTINCT emision FROM vigia.gold.alertas ORDER BY emision DESC LIMIT 12\n",
        "),\n",
        "niveles AS (\n",
        "  SELECT a.emision, CASE a.nivel WHEN 'roja' THEN 'Roja' WHEN 'amarilla' THEN 'Amarilla' WHEN 'verde' THEN 'Verde' ELSE 'Sin canal' END AS alerta\n",
        "  FROM vigia.gold.alertas a\n",
        "  JOIN emisiones e ON a.emision = e.emision\n",
        ")\n",
        "SELECT emision, alerta, count(*) AS provincias\n",
        "FROM niveles\n",
        "GROUP BY emision, alerta\n",
        "ORDER BY emision\n"
      ]
    }
  ],
